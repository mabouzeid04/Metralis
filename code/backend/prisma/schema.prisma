// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TECHNICIAN
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MachineStatus {
  RUNNING
  DOWN
  MAINTENANCE
  RETIRED
}

enum MachineCriticality {
  LOW
  MEDIUM
  HIGH
}

enum WorkOrderStatus {
  OPEN
  IN_PROGRESS
  WAITING
  CLOSED
}

enum WorkOrderType {
  CORRECTIVE
  PREVENTIVE
  INSPECTION
}

enum WorkOrderPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DocumentType {
  MANUAL
  SOP
  TROUBLESHOOTING
  OTHER
}

enum DocumentIngestionStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
}

enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AiFeedbackValue {
  HELPFUL
  NOT_HELPFUL
  CORRECT_CAUSE
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  name         String
  role         UserRole       @default(TECHNICIAN)
  status       UserStatus     @default(APPROVED)
  active       Boolean        @default(true)
  lastLoginAt  DateTime?
  approvedById String?
  approvedBy   User?          @relation("UserApprovals", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  rejectedAt   DateTime?
  rejectionReason String?
  preferences  Json?
  phoneNumber  String?
  assignmentWhatsappOptIn Boolean @default(false)
  metadata     Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  reportedWorkOrders WorkOrder[] @relation("reportedBy")
  assignedWorkOrders WorkOrder[] @relation("assignedTo")
  repairActions      RepairAction[]
  documents          Document[]
  approvals          User[]        @relation("UserApprovals")
  chatConversations  ChatConversation[]
  aiFeedback         ChatMessageFeedback[]
}

model Machine {
  id             String              @id @default(uuid())
  name           String
  code           String?
  category       String?
  line           String?
  area           String?
  manufacturer   String?
  model          String?
  serialNumber   String?
  commissionedAt DateTime?
  status         MachineStatus       @default(RUNNING)
  criticality    MachineCriticality  @default(MEDIUM)
  metadata       Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  workOrders        WorkOrder[]
  documents         Document[]        @relation("MachineDocuments")
  chatConversations ChatConversation[]

  @@index([name])
  @@index([status])
}

model WorkOrder {
  id                String            @id @default(uuid())
  publicId          String            @unique @default(dbgenerated("upper(substr(md5(random()::text), 1, 8))"))
  machineId         String
  machine           Machine           @relation(fields: [machineId], references: [id])
  title             String
  descriptionRaw    String
  status            WorkOrderStatus   @default(OPEN)
  type              WorkOrderType     @default(CORRECTIVE)
  priority          WorkOrderPriority @default(MEDIUM)
  reportedAt        DateTime          @default(now())
  reportedById      String
  reportedBy        User              @relation("reportedBy", fields: [reportedById], references: [id])
  assignedToId      String?
  assignedTo        User?             @relation("assignedTo", fields: [assignedToId], references: [id])
  startedAt         DateTime?
  completedAt       DateTime?
  symptoms          Json?
  suspectedCause    String?
  rootCause         String?
  failureMode       String?
  environmentContext Json?
  metadata          Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  repairActions RepairAction[]
  parts        WorkOrderPart[]
  attachments  Document[]        @relation("WorkOrderDocuments")
}

model RepairAction {
  id              String      @id @default(uuid())
  workOrderId     String
  workOrder       WorkOrder   @relation(fields: [workOrderId], references: [id])
  performedById   String
  performedBy     User        @relation(fields: [performedById], references: [id])
  actions         String
  partsUsed       Json?
  adjustments     String?
  verification    String?
  success         Boolean
  failureNote     String?
  rootCause       String?
  metadata        Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  attachments Document[] @relation("RepairActionDocuments")
}

model Part {
  id           String   @id @default(uuid())
  name         String
  category     String?
  partNumber   String?
  manufacturer String?
  cost         Decimal? @db.Decimal(10, 2)
  description  String?
  stockQty     Int?     @default(0)
  minStock     Int?     @default(0)
  location     String?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workOrders WorkOrderPart[]
}

model WorkOrderPart {
  id          String    @id @default(uuid())
  workOrderId String
  partId      String
  quantity    Int       @default(1)
  createdAt   DateTime  @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  part      Part      @relation(fields: [partId], references: [id])

  @@unique([workOrderId, partId])
}

model Document {
  id             String       @id @default(uuid())
  title          String
  type           DocumentType @default(MANUAL)
  filePath       String
  fileSize       Int?
  mimeType       String?
  machineId      String?
  machine        Machine?     @relation("MachineDocuments", fields: [machineId], references: [id])
  workOrderId    String?
  workOrder      WorkOrder?   @relation("WorkOrderDocuments", fields: [workOrderId], references: [id])
  repairActionId String?
  repairAction   RepairAction? @relation("RepairActionDocuments", fields: [repairActionId], references: [id])
  machineType    String?
  language       String?      @default("en")
  version        String?
  metadata       Json?
  uploadedById   String
  uploadedBy     User        @relation(fields: [uploadedById], references: [id])
  ingestionStatus DocumentIngestionStatus @default(PENDING)
  ingestedAt     DateTime?
  ingestionError String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  chunks DocumentChunk[]

  @@index([workOrderId])
  @@index([repairActionId])
}

model DocumentChunk {
  id         String               @id @default(uuid())
  documentId String
  document   Document             @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  content    String
  tokens     Int
  embedding  Unsupported("vector(1536)")
  metadata   Json?
  createdAt  DateTime             @default(now())

  @@index([documentId, chunkIndex])
  @@index([documentId])
}

model ChatConversation {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  machineId     String?
  machine       Machine?    @relation(fields: [machineId], references: [id])
  title         String
  summary       String?
  metadata      Json?
  lastMessageAt DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  messages ChatMessage[]

  @@index([userId, lastMessageAt])
  @@index([machineId])
}

model ChatMessage {
  id             String           @id @default(uuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           ChatMessageRole
  content        String
  citations      Json?
  contextChunks  Json?
  structuredOutput Json?
  createdAt      DateTime         @default(now())

  feedback ChatMessageFeedback[]

  @@index([conversationId, createdAt])
}

model ChatMessageFeedback {
  id        String          @id @default(uuid())
  messageId String
  message   ChatMessage     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     AiFeedbackValue
  createdAt DateTime        @default(now())

  @@unique([messageId, userId, value])
  @@index([userId])
}

